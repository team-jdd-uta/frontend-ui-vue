pipeline {
  agent {
    kubernetes {
      yaml """
apiVersion: v1
kind: Pod
spec:
  serviceAccountName: jenkins-kaniko-agent
  containers:
    - name: node
      image: node:24-alpine
      command:
        - cat
      tty: true
    - name: aws-cli
      image: public.ecr.aws/aws-cli/aws-cli:latest
      command:
        - cat
      tty: true
      env:
        - name: AWS_STS_REGIONAL_ENDPOINTS
          value: regional
"""
    }
  }

  options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }

  parameters {
    booleanParam(name: 'DEPLOY', defaultValue: false, description: 'main 브랜치에서 S3/CloudFront 배포를 실행합니다.')
  }

  environment {
    AWS_REGION = 'ap-northeast-2'
    JENKINS_AGENT_SERVICE_ACCOUNT = 'jenkins-kaniko-agent'
    BUILD_DIR = 'dist'
    FRONTEND_BUCKET = 'team9-mini-dev-frontend'
    CLOUDFRONT_DISTRIBUTION_ID = 'TODO_CLOUDFRONT_DISTRIBUTION_ID'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Build') {
      steps {
        container('node') {
          sh '''
            npm ci
            npm run build
          '''
        }
      }
    }

    stage('Deploy to S3') {
      when {
        allOf {
          branch 'main'
          expression { return params.DEPLOY }
        }
      }
      steps {
        container('aws-cli') {
          sh '''
            test -d "$BUILD_DIR"
            test "$CLOUDFRONT_DISTRIBUTION_ID" != "TODO_CLOUDFRONT_DISTRIBUTION_ID"

            aws s3 sync "$BUILD_DIR/" "s3://$FRONTEND_BUCKET/" \
              --region "$AWS_REGION" \
              --delete

            aws cloudfront create-invalidation \
              --distribution-id "$CLOUDFRONT_DISTRIBUTION_ID" \
              --paths "/*"
          '''
        }
      }
    }
  }
}
